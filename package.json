{
  "name": "openleague",
  "version": "0.70.3",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "dev:wake": "tsx scripts/wake-db.ts && bun run dev",
    "build": "next build",
    "vercel:build": "bun scripts/vercel-build.mjs",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "check:raw-sql": "bun scripts/check-raw-sql.ts",
    "check:mcp-pins": "bun scripts/check-mcp-pins.ts",
    "type": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "postinstall": "prisma generate --config prisma/prisma.config.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "db:migrate:reset": "prisma migrate reset --config prisma/prisma.config.ts",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:wake": "tsx scripts/wake-db.ts",
    "validate-env": "tsx scripts/validate-env.js",
    "adr": "adr",
    "adr:lint": "adr lint",
    "adr:check-integrity": "bun scripts/check-adr-integrity.ts",
    "adr:review-dates": "bun scripts/check-adr-review-dates.ts",
    "adr:new": "adr new",
    "adr:check": "adr check",
    "adr:queue": "adr queue",
    "adr:check-reports": "bun scripts/check-adr-reports.ts",
    "adr:explain": "adr explain",
    "adr:graph": "adr graph",
    "docs:build-pages": "tsx scripts/build-docs-pages.ts",
    "uptime:check": "tsx scripts/check-uptime.ts",
    "validate-deployment-config": "tsx scripts/validate-deployment-config.ts",
    "smoke": "bun scripts/smoke-test.ts",
    "deployment:check": "bun run validate-deployment-config && bun run docs:build-pages"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mailchimp/mailchimp_transactional": "^1.4.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-date-pickers": "^8.29.2",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^16.3.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.4.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@adrkit/cli": "0.7.0",
    "@adrkit/mcp": "0.7.0",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "marked": "^18.0.9",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
